# May Configuration
# Copy this file to .env and update the values

# Secret key for session encryption (generate a random string for production)
SECRET_KEY=your-secret-key-here

# Database URL (default: SQLite in data folder)
####added# DATABASE_URL=sqlite:////app/data/may.db
####added# DATABASE_URL=postgresql+psycopg://may:may@postgres:5432/may
####added# DATABASE_URL=mysql+pymysql://may:may@mysql:3306/may
####added# DATABASE_URL=mysql+pymysql://may:may@mariadb:3306/may
####added
####added# Alternatively, May can build DATABASE_URL from DB_* variables:
####added# DB_ENGINE=sqlite   # sqlite, postgres, postgresql, mysql, or mariadb
####added# DB_HOST=postgres
####added# DB_PORT=5432
####added# DB_NAME=may
####added# DB_USER=may
####added# DB_PASSWORD=may
####added# SQLITE_PATH=/app/data/may.db

# Upload folder for attachments
# UPLOAD_FOLDER=/app/data/uploads

# SMTP for notification emails. Compose defaults point at the bundled mailpit
# service (web inbox at http://localhost:8025). Values saved in the admin UI
# override these. For a real mail server, set host/credentials here:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=may@localhost
# SMTP_SENDER_NAME=May
# SMTP_TLS=false
# SMTP_SSL=false
