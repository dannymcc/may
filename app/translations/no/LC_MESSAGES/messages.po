msgstr "Ugyldig aksel"

msgid "The fitting date and reading cannot precede the current fitting."
msgstr "Monteringsdatoen og målerstanden kan ikke være før gjeldende montering."

msgid "Leave blank if the reading was not recorded. Enter 0 to confirm a genuine zero reading."
msgstr "La feltet stå tomt hvis målerstanden ikke ble registrert. Skriv 0 for å bekrefte en faktisk nullverdi."

msgid "Maintenance History"
msgstr "Vedlikeholdshistorikk"

msgid "History includes recorded completions and the latest saved service details. Earlier overwritten details cannot be recovered."
msgstr "Historikken omfatter registrerte servicer og de sist lagrede opplysningene. Tidligere overskrevne opplysninger kan ikke gjenopprettes."

msgid "No maintenance history yet."
msgstr "Ingen vedlikeholdshistorikk ennå."

msgid "Axle"
msgstr "Aksel"
